<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Every EF Core package this line depends on is a range, never a fixed version: a consumer on any
      patch of the major has to be able to install the package, and the test projects follow the same
      form so that a newer patch of the line is a restore away instead of a branch edit.
    -->
    <EfCoreVersionRange>[8.0.0,9.0.0)</EfCoreVersionRange>
    <DmProviderVersionRange>[8.3.1.47463,)</DmProviderVersionRange>

    <!--
      Design and user secrets are build and test tooling, never part of the package, but they follow
      the same range form as the dependency: the floor is the line's first patch, so a consumer-side
      patch bump is a restore away rather than a branch edit.
    -->
    <EfCoreDesignVersionRange>[8.0.0,9.0.0)</EfCoreDesignVersionRange>
    <UserSecretsVersionRange>[8.0.0,9.0.0)</UserSecretsVersionRange>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersionRange)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreDesignVersionRange)" />
    <PackageVersion Include="DM.DmProvider" Version="$(DmProviderVersionRange)" />
  </ItemGroup>

  <ItemGroup Label="Test packages">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="$(UserSecretsVersionRange)" />
  </ItemGroup>
</Project>
