<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      The EF Core dependency must carry an upper bound: the provider is built against
      internal API shapes that are not guaranteed across major versions (architecture D5).
      NuGet writes this range into the packed nuspec.
    -->
    <EfCoreVersionRange>[9.0.0,10.0.0)</EfCoreVersionRange>
    <DmProviderVersionRange>[8.3.1.47463,)</DmProviderVersionRange>

    <!--
      Design is build and test tooling, never part of the package, so it is pinned to a current
      patch instead of the range: resolving the 9.0.0 floor for it also pulls transitive
      packages that NuGet audit reports as vulnerable.
    -->
    <EfCoreDesignVersion>9.0.22</EfCoreDesignVersion>

    <!--
      The acceptance console reads a live instance's connection string from user secrets, which keeps
      credentials out of the repository. It is the only project that takes this package.
    -->
    <UserSecretsVersion>9.0.22</UserSecretsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersionRange)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreDesignVersion)" />
    <PackageVersion Include="DM.DmProvider" Version="$(DmProviderVersionRange)" />
  </ItemGroup>

  <ItemGroup Label="Test packages">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="$(UserSecretsVersion)" />
  </ItemGroup>
</Project>
