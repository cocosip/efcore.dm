<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DmProviderValidation</AssemblyName>
    <RootNamespace>DmProviderValidation</RootNamespace>
    <!--
      A place for the connection string of a live instance that is never committed. Nothing depends on
      the value at build time: the program reads it at run time, from user secrets, an environment
      variable or its argument, in that order of specificity.
    -->
    <UserSecretsId>dm-entityframeworkcore-validation</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DM.EntityFrameworkCore\DM.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
