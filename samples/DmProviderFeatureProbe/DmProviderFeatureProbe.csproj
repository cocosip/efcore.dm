<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DmProviderFeatureProbe</AssemblyName>
    <RootNamespace>DmProviderFeatureProbe</RootNamespace>
    <!--
      The same secret store as the acceptance console, so one `dotnet user-secrets set` command
      serves both live programs.
    -->
    <UserSecretsId>dm-entityframeworkcore-validation</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DM.EntityFrameworkCore\DM.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
