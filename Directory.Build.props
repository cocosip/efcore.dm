<Project>
  <PropertyGroup>
    <!-- Retargeted per branch. The EF Core 8 and 9 branches use net8.0. -->
    <DmTargetFramework Condition="'$(DmTargetFramework)' == ''">net10.0</DmTargetFramework>
    <DmVersion Condition="'$(DmVersion)' == ''">10.0.1</DmVersion>

    <!--
      The publish identity is separate from the source tree identity. Changing the NuGet
      prefix is a one-line change here: directories, assembly name, root namespace and
      test project references all stay as they are.
    -->
    <DmPackageId Condition="'$(DmPackageId)' == ''">Cocosip.DM.EntityFrameworkCore</DmPackageId>
    <DmProductName Condition="'$(DmProductName)' == ''">DM.EntityFrameworkCore</DmProductName>

    <TargetFramework>$(DmTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
