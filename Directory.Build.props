<Project>
  <PropertyGroup>
    <!-- Retargeted per branch. The EF Core 8 and 9 branches use net8.0. -->
    <DmTargetFramework Condition="'$(DmTargetFramework)' == ''">net10.0</DmTargetFramework>
    <DmVersion Condition="'$(DmVersion)' == ''">10.0.1</DmVersion>

    <!--
      The product name is the assembly name, the root namespace and the project directory.
      Only the publisher prefix is configured: every package composes its id from the prefix and
      its own identity, so a satellite package needs no change here and changing the prefix
      renames all of them at once.
    -->
    <DmPackagePrefix Condition="'$(DmPackagePrefix)' == ''">Cocosip</DmPackagePrefix>
    <DmProductName Condition="'$(DmProductName)' == ''">DM.EntityFrameworkCore</DmProductName>
    <DmPackageIdBase Condition="'$(DmPackageIdBase)' == ''">$(DmPackagePrefix).$(DmProductName)</DmPackageIdBase>

    <!--
      Packaging metadata. The author is the prefix's owner, which is the identity that reserves the
      package id, and the URL is the repository the source lives at, so a consumer reaches the source
      from the package listing. Both are defaults: a satellite package can override either.
    -->
    <DmAuthors Condition="'$(DmAuthors)' == ''">$(DmPackagePrefix)</DmAuthors>
    <DmRepositoryUrl Condition="'$(DmRepositoryUrl)' == ''">https://github.com/cocosip/efcore.dm</DmRepositoryUrl>
    <Authors>$(DmAuthors)</Authors>
    <RepositoryUrl>$(DmRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(DmRepositoryUrl)</PackageProjectUrl>

    <TargetFramework>$(DmTargetFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
