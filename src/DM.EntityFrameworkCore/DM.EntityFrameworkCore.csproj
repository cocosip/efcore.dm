<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(DmProductName)</AssemblyName>
    <!-- A satellite package appends its own suffix: $(DmPackageIdBase).NetTopologySuite -->
    <PackageId>$(DmPackageIdBase)</PackageId>
    <RootNamespace>$(DmProductName)</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The assembly ships its XML documentation, so a consumer sees the summaries in IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>efcore;entity-framework-core;dameng;dm;database;provider</PackageTags>
    <Description>Entity Framework Core provider for Dameng (DM).</Description>
    <Version>$(DmVersion)</Version>
    <AssemblyVersion>$(DmVersion).0</AssemblyVersion>
    <FileVersion>$(DmVersion).0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="DM.DmProvider" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DM.EntityFrameworkCore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
