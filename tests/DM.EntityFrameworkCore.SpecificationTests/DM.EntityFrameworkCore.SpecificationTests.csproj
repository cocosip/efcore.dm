<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DM.EntityFrameworkCore.SpecificationTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!--
      The EF Core specification package pins xunit.core, xunit.assert and its own analysis and
      templating versions, so this project is exempt from central package management. Do not raise
      its xunit versions independently of the EF Core version: they move together.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The specification base classes are internal APIs, as they are for every provider. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
    <!-- The migrations cases compile a snapshot in memory and need the runtime reference set. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <!-- The upstream cases format dates with a named culture, which invariant mode cannot resolve. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="9.0.22" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DM.EntityFrameworkCore\DM.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Skipped.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

